---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { PageEntry } from "../lib/content";
import { optimizedImage } from "../lib/content";
interface Props { entry: PageEntry; Content: AstroComponentFactory; headings: Array<{ depth: number; slug: string; text: string }>; siblings: PageEntry[]; }
const { entry, Content, headings } = Astro.props;
const { data } = entry;
---
<header class="site-wrap py-14 md:py-20"><p class="eyebrow">{data.pageType === "guide" ? "Singapore travel & transport guides" : "Airport Transfer Singapore"}</p><h1 class="display mt-4 max-w-5xl">{data.title}</h1><p class="mt-7 max-w-3xl text-lg leading-8 text-muted">{data.description}</p>{data.datePublished && <p class="mt-6 text-xs uppercase tracking-[.08em] text-muted">{data.datePublished.toLocaleDateString("en-SG", {year:"numeric", month:"long", day:"numeric"})} {data.author ? ` · ${data.author}` : ""}</p>}</header>
{data.image && <div class="site-wrap"><img class="h-[320px] w-full object-cover md:h-[600px]" src={optimizedImage(data.image)} alt={data.imageAlt ?? data.title} width="1280" height="600" decoding="async" /></div>}
<div class="site-wrap grid gap-12 py-16 md:grid-cols-12 md:py-24">
  {headings.length > 1 && <aside class="md:col-span-3"><div class="sticky top-28 border-t border-mist pt-5"><p class="eyebrow mb-4">Contents</p>{headings.filter((h) => h.depth === 2).map((h) => <a class="block border-b border-mist py-3 text-sm text-muted hover:text-ink" href={`#${h.slug}`}>{h.text}</a>)}</div></aside>}
  <article class:list={["prose-editorial", headings.length > 1 ? "md:col-span-8 md:col-start-5" : "mx-auto max-w-3xl md:col-span-12"]}><Content /></article>
</div>
<section class="bg-black py-16 text-white"><div class="site-wrap flex flex-col items-start justify-between gap-8 md:flex-row md:items-center"><div><p class="eyebrow">Need transport?</p><h2 class="section-title mt-3">Plan your Singapore journey.</h2></div><a class="btn-primary border-white bg-white text-black hover:bg-soft" href="/contact/">Request a Quote</a></div></section>
