---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { PageEntry } from "../lib/content";
import { optimizedImage } from "../lib/content";
import BookingIframe from "../components/BookingIframe.astro";
interface Props { entry: PageEntry; Content: AstroComponentFactory; siblings: PageEntry[]; }
const { entry, Content } = Astro.props;
const { data } = entry;
---
<section class="site-wrap grid gap-10 py-14 md:grid-cols-2 md:items-center md:py-20">
  <div><p class="eyebrow">{data.service ?? "Chauffeur service"}</p><h1 class="display mt-4">{data.title}</h1><p class="mt-7 max-w-xl text-lg leading-8 text-muted">{data.description}</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary" href="#booking">Request a Quote</a><a class="btn-secondary" href="/contact/">Call or Email</a></div></div>
  <img class="h-[360px] w-full object-cover md:h-[520px]" src={optimizedImage(data.image ?? "/images/fleet/fleet-lineup-s-class-v-class-wide-plate-safe.png")} alt={data.imageAlt ?? data.title} width="720" height="520" fetchpriority="high" decoding="async" />
</section>
<!-- Required placement: the booking/enquiry module immediately follows every service hero. -->
<BookingIframe />
<article class="prose-editorial site-wrap max-w-[860px] pb-20 md:pb-28"><Content /></article>
{data.faq?.length ? <section class="site-wrap border-t border-mist py-20"><p class="eyebrow">Questions</p><h2 class="section-title mt-3 mb-10">Frequently asked questions</h2><div>{data.faq.map((item) => <details class="border-b border-mist py-5"><summary class="cursor-pointer font-display text-xl font-medium">{item.question}</summary><p class="mt-4 max-w-3xl leading-7 text-muted">{item.answer}</p></details>)}</div></section> : null}
<section class="bg-black py-16 text-white"><div class="site-wrap flex flex-col items-start justify-between gap-8 md:flex-row md:items-center"><div><p class="eyebrow">Next journey</p><h2 class="section-title mt-3">Tell us where you need to be.</h2></div><a class="btn-primary border-white bg-white text-black hover:bg-soft" href="/contact/">Request a Quote</a></div></section>
