---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { PageEntry } from "../lib/content";
import { optimizedImage } from "../lib/content";
import BookingIframe from "../components/BookingIframe.astro";

interface Props {
  entry: PageEntry;
  Content: AstroComponentFactory;
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { entry, Content, headings } = Astro.props;
const { data } = entry;
const h1 = data.heading ?? data.title;
const sectionLinks = headings.filter((heading) => heading.depth === 2);
---

<header class="border-b border-mist bg-ivory">
  <div class="site-wrap grid gap-10 py-14 md:grid-cols-12 md:items-center md:py-20">
    <div class="md:col-span-7">
      <h1 class="display max-w-4xl">{h1}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">{data.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="#booking">Book online</a>
        <a class="btn-secondary" href="/contact/">Request a quote</a>
      </div>
    </div>
    <div class="md:col-span-5">
      <img class="h-[360px] w-full object-cover md:h-[500px]" src={optimizedImage(data.image ?? "/images/fleet/fleet-lineup-s-class-v-class-wide-plate-safe.png")} alt={data.imageAlt ?? h1} width="720" height="520" fetchpriority="high" decoding="async" />
    </div>
  </div>
</header>

<BookingIframe showVerificationNote={false} />

<div class="site-wrap grid gap-12 py-16 md:grid-cols-12 md:py-24">
  {sectionLinks.length > 1 && (
    <aside class="md:col-span-3">
      <nav class="sticky top-28 border-t border-mist pt-5" aria-label="On this page">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[.12em] text-brass">On this page</p>
        {sectionLinks.map((heading) => <a class="block border-b border-mist py-3 text-sm leading-5 text-muted hover:text-ink" href={`#${heading.slug}`}>{heading.text}</a>)}
      </nav>
    </aside>
  )}
  <article class:list={["prose-editorial sales-prose", sectionLinks.length > 1 ? "md:col-span-8 md:col-start-5" : "mx-auto max-w-4xl md:col-span-12"]}>
    <Content />
  </article>
</div>

{data.faq?.length ? (
  <section class="border-y border-mist bg-paper py-20 md:py-24">
    <div class="site-wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4"><h2 class="section-title">Frequently asked questions</h2></div>
      <div class="md:col-span-7 md:col-start-6">
        {data.faq.map((item) => (
          <details class="disclosure border-b border-mist">
            <summary>{item.question}</summary>
            <div><p>{item.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
) : null}

<section class="bg-black py-16 text-white">
  <div class="site-wrap flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <h2 class="section-title max-w-2xl">Book the right vehicle for your arrival.</h2>
    <a class="btn-primary border-white bg-white text-black hover:bg-soft" href="#booking">Book online</a>
  </div>
</section>
