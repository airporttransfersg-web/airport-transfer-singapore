---
import site from "../../site.config";
import { releasedRouteSet } from "../lib/content";
const { currentPath = "/" } = Astro.props;
const releasedRoutes = await releasedRouteSet();
const navigation = site.navigation.filter((item) => releasedRoutes.has(item.href));
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-mist bg-ivory/95">
  <div class="site-wrap flex h-[72px] items-center justify-between gap-6">
    <a href="/" class="inline-flex min-h-11 items-center" aria-label={site.shortName}><img src={site.logo} alt={site.shortName} class="h-11 w-auto max-w-[190px] object-contain" /></a>
    <nav class="hidden items-center gap-7 text-[13px] font-medium lg:flex" aria-label="Primary">
      {navigation.map((item) => <a class:list={["py-2 hover:text-brass", currentPath.startsWith(item.href) && "border-b border-brass"]} href={item.href}>{item.label}</a>)}
    </nav>
    <div class="hidden items-center gap-4 lg:flex">
      <a class="text-[13px] font-semibold" href={site.booking.url}>{site.booking.label}</a>
      <a class="btn-primary min-h-[42px] px-5" href="/contact/">Request a Quote</a>
    </div>
    <button class="inline-flex h-11 w-11 items-center justify-center lg:hidden" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-toggle>
      <svg class="h-6 w-6" data-menu-icon-open aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="hidden h-6 w-6" data-menu-icon-close aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-mist bg-ivory px-5 py-5 lg:hidden" aria-label="Mobile" data-menu-panel>
    {navigation.map((item) => <a class="block border-b border-mist py-3 font-medium" href={item.href}>{item.label}</a>)}
    <div class="mt-5 grid grid-cols-2 gap-3"><a class="btn-secondary" href={site.booking.url}>Book Online</a><a class="btn-primary" href="/contact/">Request a Quote</a></div>
  </nav>
</header>
<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const panel = document.querySelector("[data-menu-panel]");
  const openIcon = toggle?.querySelector("[data-menu-icon-open]");
  const closeIcon = toggle?.querySelector("[data-menu-icon-close]");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    panel?.classList.toggle("hidden", open);
    openIcon?.classList.toggle("hidden", !open);
    closeIcon?.classList.toggle("hidden", open);
  });
</script>
