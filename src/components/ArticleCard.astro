---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  category?: string;
  datePublished?: Date;
  readingTime?: string;
}

const { title, description, href, image, imageAlt, category, datePublished, readingTime } =
  Astro.props;

const dateLabel = datePublished?.toLocaleDateString("en-SG", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class="group">
  <a href={href} class="block">
    <div class="relative mb-4 h-[240px] w-full overflow-hidden rounded-lg">
      <img
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        src={image}
        alt={imageAlt}
        loading="lazy"
        width={800}
        height={480}
      />
      <div class="absolute inset-0 bg-deep-charcoal/10 pointer-events-none" aria-hidden="true"></div>
    </div>
    {category && <span class="mb-2 block font-body text-label-caps uppercase tracking-widest text-champagne-gold">{category}</span>}
    <h3 class="mb-2 font-display text-headline-md text-primary transition-colors duration-300 group-hover:text-champagne-gold">{title}</h3>
    <p class="mb-4 line-clamp-2 font-body text-body-md text-on-surface-variant">{description}</p>
    <div class="flex items-center space-x-4 font-body text-sm text-outline">
      {dateLabel && <span>{dateLabel}</span>}
      {dateLabel && readingTime && <span aria-hidden="true">•</span>}
      {readingTime && <span>{readingTime} read</span>}
    </div>
  </a>
</article>
