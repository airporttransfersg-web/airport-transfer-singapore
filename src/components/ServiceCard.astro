---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  eyebrow?: string;
}

const { title, description, href, image, imageAlt, eyebrow } = Astro.props;
---

<a class="group flex h-full flex-col border border-champagne-gold/30 bg-surface-container-lowest transition-shadow duration-300 hover:shadow-sm" href={href}>
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-surface-variant">
    <div class="absolute inset-0 z-10 bg-deep-charcoal/10 pointer-events-none" aria-hidden="true"></div>
    <img
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      src={image}
      alt={imageAlt}
      loading="lazy"
      width={960}
      height={720}
    />
  </div>
  <div class="flex grow flex-col p-8">
    {eyebrow && <span class="mb-2 font-body text-label-caps uppercase tracking-wider text-champagne-gold">{eyebrow}</span>}
    <h3 class="mb-3 font-display text-headline-md text-primary transition-colors group-hover:text-champagne-gold">{title}</h3>
    <p class="mt-auto font-body text-body-md text-on-surface-variant">{description}</p>
  </div>
</a>
