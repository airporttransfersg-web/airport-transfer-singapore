---
import SiteShell from "../layouts/SiteShell.astro";
---

<SiteShell
  title="Page not found"
  description="The requested page could not be found. Browse Airport Transfer Singapore services or return to the homepage."
  path="/404/"
  noindex={true}
>
  <section class="site-wrap flex min-h-[62vh] flex-col justify-center py-20 md:py-28">
    <p class="eyebrow">Error 404</p>
    <h1 class="display mt-4 max-w-4xl">This page could not be found.</h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">
      The address may have changed or the page may no longer exist. Continue to our transport services or return to the homepage.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a class="btn-primary" href="/services/">Explore services</a>
      <a class="btn-secondary" href="/">Return home</a>
    </div>
  </section>
</SiteShell>
