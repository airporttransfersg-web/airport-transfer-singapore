---
import SiteShell from "../../layouts/SiteShell.astro";
import { optimizedImage, pagesOfType } from "../../lib/content";
const articles = [...await pagesOfType("guide"), ...await pagesOfType("article")];
const [featured, ...rest] = articles;
---
<SiteShell title="Singapore Transport Guides" description="Practical guidance for airport transfers, chauffeur bookings and getting around Singapore." path="/blog/">
  <header class="site-wrap py-16 md:py-24"><p class="eyebrow">Singapore travel & transport guides</p><h1 class="display mt-4 max-w-5xl">Useful guidance for moving through Singapore.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-muted">Practical articles for Changi Airport arrivals, business travel and choosing a vehicle for your group.</p></header>
  {featured && <article class="site-wrap grid gap-10 border-y border-mist py-12 md:grid-cols-2 md:items-center"><img class="h-80 w-full object-cover" src={optimizedImage(featured.data.image)} alt={featured.data.imageAlt ?? featured.data.title} loading="lazy" decoding="async" /><div><p class="eyebrow">Airport guides</p><h2 class="section-title mt-3">{featured.data.title}</h2><p class="mt-5 leading-7 text-muted">{featured.data.description}</p><a class="mt-7 inline-block border-b border-ink text-sm font-semibold" href={featured.data.slug}>Read the guide</a></div></article>}
  <section class="site-wrap grid gap-x-8 gap-y-12 py-20 md:grid-cols-3">{rest.map((entry) => <article class="border-t border-mist pt-6"><p class="eyebrow">{entry.data.pageType === "guide" ? "Airport guides" : "Travel notes"}</p><h2 class="mt-4 font-display text-2xl font-medium leading-tight"><a href={entry.data.slug}>{entry.data.title}</a></h2><p class="mt-4 leading-7 text-muted">{entry.data.description}</p><a class="mt-6 inline-block border-b border-ink text-sm font-semibold" href={entry.data.slug}>Read article</a></article>)}</section>
  <section class="bg-black py-16 text-white"><div class="site-wrap flex flex-col items-start justify-between gap-8 md:flex-row md:items-center"><h2 class="section-title">Need transport rather than another article?</h2><a class="btn-primary border-white bg-white text-black" href="/contact/">Request a Quote</a></div></section>
</SiteShell>
