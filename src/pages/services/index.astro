---
import SiteShell from "../../layouts/SiteShell.astro";
import { optimizedImage, pagesOfType } from "../../lib/content";
const services = await pagesOfType("service");
---
<SiteShell title="Chauffeur & Transport Services" description="Airport transfers, hourly chauffeur hire, corporate transport and group journeys in Singapore." path="/services/">
  <header class="site-wrap py-16 md:py-24"><p class="eyebrow">Services</p><h1 class="display mt-4 max-w-5xl">Transport services for every kind of Singapore journey.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-muted">Choose a service below, or send your itinerary and we will help identify the right arrangement.</p></header>
  <section class="site-wrap pb-24"><div class="divide-y divide-mist border-t border-mist">{services.map((entry, i) => <article class="grid gap-8 py-10 md:grid-cols-12 md:items-center"><div class="md:col-span-1 text-xs text-brass">0{i+1}</div><img class="h-64 w-full object-cover md:col-span-4" src={optimizedImage(entry.data.image)} alt={entry.data.imageAlt ?? entry.data.title} loading="lazy" decoding="async" /><div class="md:col-span-6 md:col-start-7"><h2 class="section-title">{entry.data.heading ?? entry.data.title}</h2><p class="mt-4 leading-7 text-muted">{entry.data.description}</p><a class="mt-6 inline-block border-b border-ink text-sm font-semibold" href={entry.data.slug}>Explore service</a></div></article>)}</div></section>
  <section class="bg-black py-16 text-white"><div class="site-wrap flex flex-col items-start justify-between gap-8 md:flex-row md:items-center"><h2 class="section-title">Not sure which service fits?</h2><a class="btn-primary border-white bg-white text-black" href="/contact/">Request a Quote</a></div></section>
</SiteShell>
