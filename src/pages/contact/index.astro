---
import SiteShell from "../../layouts/SiteShell.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import site from "../../../site.config";
const mapEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.6998949083804!2d103.93089637496576!3d1.356671598630488!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31da3d73b4501cef%3A0xedf84093f7f337fd!2s730%20Tampines%20Street%2071%2C%20Block%20730%2C%20Singapore%20520730!5e0!3m2!1sen!2ssg!4v1789025858437!5m2!1sen!2ssg";
---
<SiteShell title="Request a Quote" description="Send your Singapore airport transfer or chauffeur itinerary for a tailored quotation." path="/contact/" noindex={true}>
  <header class="site-wrap py-14 md:py-20"><p class="eyebrow">Contact</p><h1 class="display mt-4">Tell us about your journey.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-muted">Share the flight, route, passengers and luggage. We will use those details to recommend a vehicle and prepare a quotation.</p></header>
  <section class="site-wrap grid gap-12 pb-24 md:grid-cols-12">
    <div class="border border-mist bg-paper p-6 md:col-span-8 md:p-10"><QuoteForm includeConsent /></div>
    <aside class="md:col-span-3 md:col-start-10"><p class="eyebrow">Other ways</p><p class="mt-5 leading-7 text-muted">Prefer to send your itinerary directly? Email the booking team and include your date, route, passengers and luggage.</p><div class="mt-5 divide-y divide-mist border-y border-mist"><div class="py-4"><p class="text-xs uppercase tracking-wider text-muted">Email</p><a class="mt-2 block font-semibold" href={`mailto:${site.email}`}>{site.email}</a></div><div class="py-4"><p class="text-xs uppercase tracking-wider text-muted">Address</p><address class="mt-2 not-italic leading-6 text-muted">{site.address}</address></div><div class="py-4"><p class="text-xs uppercase tracking-wider text-muted">Booking app</p><a class="mt-2 block font-semibold" href={site.booking.url}>Book Online</a></div></div><div class="mt-8 overflow-hidden border border-mist bg-paper"><iframe title="Map showing Block 730, Tampines Street 71, Singapore 520730" src={mapEmbedUrl} class="block h-[180px] w-full border-0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></aside>
  </section>
</SiteShell>
